{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TwoMuchLabs/reversibility-classes/schema/rclass.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Reversibility Classes — classification record",
  "description": "Assigns Reversibility Classes (R0–R4) to the tools of one tool server. See SPEC.md.",
  "type": "object",
  "required": [
    "spec_version",
    "server",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^0\\.[1-4]$"
    },
    "server": {
      "type": "object",
      "required": [
        "id",
        "name",
        "source",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "version": {
          "type": "string"
        },
        "min_version": {
          "type": "string",
          "pattern": "^v?\\d+(\\.\\d+){0,2}$",
          "description": "The earliest release the record's rules were checked against (SPEC 5.1). A deployment pinned to an older release, or to one whose version cannot be read, gets the base class of each tool: rules that lower a class do not apply."
        },
        "status": {
          "enum": [
            "active",
            "archived"
          ]
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "description": "Install identifiers people use to run this server, without a version: npm or PyPI package names, or container images. Lets tools such as `rclass scan` recognise the server in a client config."
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "description": "URLs of hosted (remote) deployments that expose this record's tool set."
        },
        "notes": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "For a deployment override: who is accountable for it, e.g. a team (SPEC 5.5)."
        },
        "approved_by": {
          "type": "string",
          "minLength": 1,
          "description": "For a deployment override: who approved it (SPEC 5.5)."
        },
        "expires": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "For a deployment override: the last day it may lower a class, as YYYY-MM-DD (SPEC 5.5)."
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "For a deployment override: the environments it applies in, e.g. [\"dev\"] (SPEC 5.5)."
        }
      }
    },
    "default_class": {
      "$ref": "#/$defs/class"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "class": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "class",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "$ref": "#/$defs/class"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "disclosure": {
          "type": "boolean",
          "description": "True if the tool's effect includes a disclosure (SPEC 4.1 rule 2). An override can lower such a tool only by explicitly setting disclosure: false (SPEC 5.5)."
        },
        "egress": {
          "type": "boolean",
          "description": "True if the tool sends content the caller chooses to a destination the caller chooses, such as a URL (SPEC 5.2). After a session has read data, such a call is R4 unless its destination is allow-listed (SPEC 9)."
        },
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "compensation": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "undo_window": {
          "type": "string",
          "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$"
        },
        "review": {
          "enum": [
            "draft",
            "reviewed",
            "verified"
          ]
        },
        "preimage": {
          "type": "object",
          "description": "Deployment overrides only (SPEC 5.6): the deployment captures the prior state before each call, which lets it declare the tool R1. Never used in the open registry.",
          "required": [
            "captures",
            "restore",
            "retention"
          ],
          "additionalProperties": false,
          "properties": {
            "captures": {
              "type": "string",
              "minLength": 1,
              "description": "Exactly what prior state is captured, in full, before the call."
            },
            "restore": {
              "type": "string",
              "minLength": 1,
              "description": "How the principal writes the captured state back, through an interface it already holds."
            },
            "retention": {
              "type": "string",
              "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
              "description": "ISO 8601 duration the capture is kept; restoration is possible only within it."
            }
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "arg"
      ],
      "additionalProperties": false,
      "properties": {
        "arg": {
          "type": "string",
          "minLength": 1,
          "description": "Argument name; dots address nested fields, e.g. options.force"
        },
        "equals": {},
        "in": {
          "type": "array",
          "minItems": 1
        },
        "matches": {
          "type": "string",
          "minLength": 1
        },
        "absent": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "in"
          ]
        },
        {
          "required": [
            "matches"
          ]
        },
        {
          "required": [
            "absent"
          ]
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": [
        "class",
        "rationale"
      ],
      "properties": {
        "arg": {
          "type": "string"
        },
        "equals": {},
        "in": {
          "type": "array",
          "minItems": 1
        },
        "matches": {
          "type": "string"
        },
        "absent": {
          "type": "boolean"
        },
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "class": {
          "$ref": "#/$defs/class"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "all"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "arg"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "arg"
          ],
          "not": {
            "required": [
              "all"
            ]
          },
          "oneOf": [
            {
              "required": [
                "equals"
              ]
            },
            {
              "required": [
                "in"
              ]
            },
            {
              "required": [
                "matches"
              ]
            },
            {
              "required": [
                "absent"
              ]
            }
          ]
        }
      ]
    }
  }
}
